{
  "name": "tailnote",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "npx tsx scripts/seed.ts",
    "migrate:legacy": "npx tsx scripts/migrate-legacy.ts",
    "migrate:default-free-plan": "npx tsx scripts/migrate-default-free-plan.ts",
    "verify:signature": "npm run email-client-smoke --workspace=emailsignature-engine && npx tsx scripts/vcard-smoke.ts && npx tsx scripts/clipboard-smoke.ts && npx tsx scripts/security-headers-smoke.ts && npx tsx scripts/email-assets-smoke.ts",
    "verify:blog": "npx tsx scripts/blog-smoke.ts",
    "migrate:blog": "npx tsx scripts/migrate-blog-mdx-to-mongo.ts",
    "verify:list-tracking": "npx tsx scripts/signature-tracking-list-smoke.ts",
    "verify:open-tracking": "npx tsx scripts/signature-open-tracking-smoke.ts",
    "verify:freemium": "npx tsx scripts/freemium-smoke.ts",
    "icons:reddit": "node scripts/generate-reddit-icon.mjs",
    "optimize:email-assets": "node scripts/optimize-email-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.2.8",
    "billing-engine": "workspace:*",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emailsignature-engine": "workspace:*",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.12.0",
    "mongoose": "^8.9.5",
    "next": "^15.1.0",
    "next-mdx-remote": "^6.0.0",
    "posthog-js": "^1.376.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "recharts": "^3.8.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "shiki": "^4.1.0",
    "stripe": "^17.5.0",
    "svgo": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tiptap-markdown": "^0.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
