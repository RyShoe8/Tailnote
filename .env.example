# Copy into Vercel: Project → Settings → Environment Variables. See SETUP.md.

MONGODB_URI=
MONGODB_DB_NAME=emailsignature

BETTER_AUTH_SECRET=
# Your Vercel deployment URL or custom domain (no trailing slash)
BETTER_AUTH_URL=https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Stripe Tax product category for subscription plans (default: txcd_10103001 SaaS business use)
# STRIPE_PLAN_PRODUCT_TAX_CODE=txcd_10103001

# Optional: same as public app URL if you use relative /images/... in signatures and need absolute URLs in copied HTML
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Transactional email + contact sync (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Optional; defaults to Tailnote Team
# BREVO_SENDER_NAME=Tailnote Team
# Optional; defaults to list 3
# BREVO_LIST_ID=3

# Vercel Blob — organization logo uploads (POST /api/dashboard/organization/logo)
BLOB_READ_WRITE_TOKEN=

# PostHog product analytics (Email Health funnel, page views)
NEXT_PUBLIC_POSTHOG_KEY=
# Optional; defaults to https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google reCAPTCHA v3 (contact form + email auth). Omit both keys to disable in local dev.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Optional minimum score (default 0.5)
# RECAPTCHA_MIN_SCORE=0.5

# Google OAuth for Sign in with Google (Better Auth). Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
